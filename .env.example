# Variáveis de Ambiente para Desenvolvimento Local
# Copie este arquivo para .env e preencha com seus valores

# Mercado Pago Public Key (OBRIGATÓRIO)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
VITE_MP_PUBLIC_KEY=APP_USR-sua-chave-aqui

# Chave de Criptografia para localStorage (Opcional)
# Use uma string forte e única para produção
ENCRYPTION_KEY=sua-chave-secreta-aqui

# URL da API (Opcional)
# URL do backend FastAPI
API_URL=https://ssw-intelligence-api.onrender.com
