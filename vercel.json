{
  "version": 2,
  "builds": [
    {
      "src": "src/pages/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "src/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/src/pages/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/src/pages/index.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/src/assets/$1"
    },
    {
      "src": "/styles/(.*)",
      "dest": "/src/styles/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "/src/components/$1"
    },
    {
      "src": "/hooks/(.*)",
      "dest": "/src/hooks/$1"
    },
    {
      "src": "/services/(.*)",
      "dest": "/src/services/$1"
    },
    {
      "src": "/utils/(.*)",
      "dest": "/src/utils/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/$1"
    }
  ],
  "outputDirectory": "public"
}
