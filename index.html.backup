                        <!-- Modo Comparativo -->
                        <div id="compareSearchBar" class="hidden search-bar-hero compare-mode">
                            <div class="flex-1 flex items-center gap-2 px-4">
                                <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
                                <input type="text" id="compareUrlA" placeholder="Site A - https://site-a.com" class="flex-1 bg-transparent text-white outline-none text-sm" onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('compareUrlB').focus();}">
                            </div>
                            <div class="w-px h-8 bg-slate-600"></div>
                            <div class="flex-1 flex items-center gap-2 px-4">
                                <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
                                <input type="text" id="compareUrlB" placeholder="Site B - https://site-b.com" class="flex-1 bg-transparent text-white outline-none text-sm" onkeydown="if(event.key==='Enter'){event.preventDefault();if(!USER||!USER.email){showAuthScreen();return;}runCompare();}">
                            </div>
                            <button onclick="if(!USER||!USER.email){showAuthScreen();return;}runCompare()" class="search-button">
                                <i data-lucide="git-compare" class="w-4 h-4"></i>
                                Comparar
                            </button>
                        </div>
                        
                        <!-- Audit Mode Selector -->
                        <div class="flex items-center justify-center gap-4 mt-4">
                            <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer hover:text-white transition-colors">
                                <input type="radio" name="auditMode" value="auto" checked class="accent-primary" onchange="document.getElementById('auditMode').value='auto';toggleManualSelect();">
                                <span>Automático</span>
                            </label>
                            <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer hover:text-white transition-colors">
                                <input type="radio" name="auditMode" value="manual" class="accent-primary" onchange="document.getElementById('auditMode').value='manual';toggleManualSelect();">
                                <span>Manual</span>
                            </label>
                            <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer hover:text-white transition-colors">
                                <input type="radio" name="auditMode" value="compare" class="accent-primary" onchange="document.getElementById('auditMode').value='compare';toggleManualSelect();">
                                <span>Comparativo</span>
                            </label>
                        </div>
                        <select id="auditMode" class="hidden">
                            <option value="auto">Seleção Automática</option>
                            <option value="manual">Seleção Manual</option>
                            <option value="compare">Modo Comparativo</option>
                        </select>
