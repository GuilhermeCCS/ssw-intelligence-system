                                <i data-lucide="search" class="w-5 h-5 search-icon"></i>
                                <input type="text" id="auditUrl" placeholder="https://seusite.com.br" class="search-input" onkeydown="if(event.key==='Enter'){event.preventDefault();if(!USER||!USER.email){showAuthScreen();return;}runAudit();}">
                            </div>
