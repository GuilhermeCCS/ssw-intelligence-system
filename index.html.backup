            <script>
        
        // Variável global de usuário
        let USER = null;
        
        // === 1. INICIALIZAÇÃO ===

            window.onload = () => {

            lucide.createIcons();

            const saved = localStorage.getItem('ssw_user');

            if(saved) {

                USER = JSON.parse(saved);

                loginSuccess();

            }
            
            // Atualiza os botões
            updateUserMenuCircle();
            updateAuthButton();

            }; // Fecha window.onload




        
        // === 2. UI HELPERS ===



        function toggleSidebar() {
            const mobileMenu = document.getElementById('mobileMenuDropdown');
            const overlay = document.getElementById('sidebarOverlay');
            
            if(!mobileMenu) return;
            
            // Verifica se está aberto ou fechado
            const isOpen = !mobileMenu.classList.contains('hidden');
            
            if(isOpen) {
                // Fecha menu mobile
                mobileMenu.classList.add('hidden');
                if(overlay) overlay.classList.add('hidden');
            } else {
                // Abre menu mobile
                mobileMenu.classList.remove('hidden');
                if(overlay) overlay.classList.remove('hidden');
            }
        }







        // Scroll suave para um elemento
        function smoothScrollTo(elementId) {
            const element = document.getElementById(elementId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Função auxiliar para gerenciar UI de comparação
        function updateCompareUI(showResults = false) {
            const emptyState = document.getElementById('emptyStateCards');
            const compareArea = document.getElementById('compareArea');
            const auditResults = document.getElementById('auditResults');
            const auditLoading = document.getElementById('auditLoading');
            
            if (showResults) {
                // Mostra resultados
                if (auditResults) auditResults.classList.remove('hidden');
                if (auditLoading) auditLoading.classList.add('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                if (compareArea) compareArea.classList.add('hidden');
            } else {
                // Mostra inputs
                if (auditResults) auditResults.classList.add('hidden');
                if (auditLoading) auditLoading.classList.add('hidden');
                if (emptyState) emptyState.classList.remove('hidden');
                if (compareArea) compareArea.classList.remove('hidden');
            }
        }




        // Suporte global a teclado - atalhos e navegação
        document.addEventListener('keydown', (e) => {
            // ESC fecha modais abertos
            if(e.key === 'Escape') {
                // Fecha sidebar em mobile
                const sb = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');
                if(window.innerWidth < 768 && !sb.classList.contains('-translate-x-full')) {
                    sb.classList.add('-translate-x-full');
                    if(overlay) overlay.classList.add('hidden');
                }
            }
            
            // Alt + N vai para Nova Análise
            if(e.altKey && e.key.toLowerCase() === 'n') {
                e.preventDefault();
                nav('home');
                document.getElementById('auditUrl')?.focus();
            }
            
            // Alt + P vai para Personas
            if(e.altKey && e.key.toLowerCase() === 'p') {
                e.preventDefault();
                nav('personas');
            }
            
            // Alt + R vai para Ranking
            if(e.altKey && e.key.toLowerCase() === 'r') {
                e.preventDefault();
                nav('ranking');
            }
            
            // Alt + M mostra/esconde menu
            if(e.altKey && e.key.toLowerCase() === 'm') {
                e.preventDefault();
                toggleSidebar();
            }
        });
        window.addEventListener('resize', () => {
            const sb = document.getElementById('appSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const isDesktop = window.innerWidth >= 768;
            
            if(isDesktop) {
                // Em desktop, sempre mostra o sidebar (remove translate)
                sb.classList.remove('-translate-x-full');
                if(overlay) overlay.classList.add('hidden');
            } else {
                // Em mobile, reseta para o estado fechado padrão
                sb.classList.add('-translate-x-full');
                sb.classList.remove('sidebar-closed');
                if(overlay) overlay.classList.add('hidden');
            }
        });

        function toggleRegister() {



            document.getElementById('loginForm').classList.toggle('hidden');



            document.getElementById('registerForm').classList.toggle('hidden');



        }







        function nav(view) {
            // Verifica se usuário está autenticado, senão mostra cadastro e não navega
            if (!USER || !USER.email) {
                showAuthScreen();
                return;
            }
            
            // Atualiza indicadores ativos na sidebar
            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('active', 'bg-primary/10', 'border-primary/30');
                btn.classList.add('border-transparent');
                const indicator = btn.querySelector('.nav-indicator');
                if (indicator) indicator.remove();
            });
            
            // Adiciona classe ativa ao botão atual
            const activeBtn = document.querySelector(`button[onclick="nav('${view}')"]`);
            if (activeBtn) {
                activeBtn.classList.add('active', 'bg-primary/10', 'border-primary/30');
                activeBtn.classList.remove('border-transparent');
                if (!activeBtn.querySelector('.nav-indicator')) {
                    activeBtn.insertAdjacentHTML('afterbegin', '<div class="nav-indicator"></div>');
                }
            }
            
            // Esconde todas as views
            const views = ['home', 'personas', 'ranking', 'precos', 'about', 'terms', 'tutorial'];
            views.forEach(v => {
                const el = document.getElementById(`view-${v}`);
                if (el) {
                    el.classList.add('hidden');
                    el.style.opacity = '';
                    el.style.transform = '';
                    el.style.transition = '';
                }
            });
            
            // Mostra a view selecionada
            const targetEl = document.getElementById(`view-${view}`);
            if (targetEl) {
                targetEl.classList.remove('hidden');
            }
            
            // Header Dinâmico
            const titles = { 
                'personas': 'Gestão de Perfis', 
                'ranking': 'Ranking Global',
                'precos': 'Planos e Preços',
                'about': 'Sobre Nós',
                'terms': 'Termos de Uso',
                'tutorial': 'Como Usar o Sistema',
                'home': 'Painel Principal'
            };
            
            if(view === 'personas') loadManagePersonas();
            if(view === 'ranking') loadRanking();
            
            // Restaura cards e esconde resultados ao voltar para home
            if(view === 'home') {
                const emptyStateCards = document.getElementById('emptyStateCards');
                const auditResults = document.getElementById('auditResults');
                const auditLoading = document.getElementById('auditLoading');
                
                if(emptyStateCards) emptyStateCards.classList.remove('hidden');
                if(auditResults) auditResults.classList.add('hidden');
                if(auditLoading) auditLoading.classList.add('hidden');
            }
            
            // Scroll para o topo
            const mainContent = document.getElementById('mainContent');
            if (mainContent) {
                mainContent.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }







        // === 3. AUTH LOGIC ===



        async function fazerLogin() {



            const email = document.getElementById('loginEmail').value;



            const pass = document.getElementById('loginPass').value;



            if(!email || !pass) return Toast.warning("Preencha todos os campos");







            try {



                const res = await fetch(`${API_URL}/api/login`, {



                    method: 'POST', headers: {'Content-Type': 'application/json'},



                    body: JSON.stringify({ email, senha: pass })



                });



                const data = await res.json();



                if(res.ok) {



                    USER = data;



                    localStorage.setItem('ssw_user', JSON.stringify(data));



                    loginSuccess();



                } else Toast.error(data.detail || "Erro no login");



            } catch(e) { 
                console.error('Erro de login (index.html):', e);
                
                // Verifica se é erro de rede/conexão
                if (e.name === 'TypeError' && e.message.includes('fetch')) {
                    Toast.error("Sem conexão com o servidor.");
                } else if (e.name === 'SyntaxError') {
                    Toast.error("Erro na resposta do servidor.");
                } else {
                    Toast.error("Ocorreu um erro inesperado.");
                }
            }



        }







        async function fazerCadastro() {
            const nome = document.getElementById('regNome').value;
            const email = document.getElementById('regEmail').value;
            const pass = document.getElementById('regPass').value;
            
            try {
                const res = await fetch(`${API_URL}/api/register`, {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ nome, email, senha: pass })
                });
                if(res.ok) { 
                    Toast.success("Conta criada! Um código de verificação foi enviado para seu e-mail.");
                    
                    // Limpa formulário
                    document.getElementById('regNome').value = "";
                    document.getElementById('regEmail').value = "";
                    document.getElementById('regPass').value = "";
                    
                    // Esconde formulário de cadastro
                    document.getElementById('registerForm').classList.add('hidden');
                    
                    // Mostra tela de verificação diretamente
                    document.getElementById('verifyModal').classList.remove('hidden');
                    lucide.createIcons();
                    
                    // Inicia a contagem de reenvio
                    iniciarContagemReenvio();
                } else Toast.error("Erro ao criar conta");
            } catch(e) { 
                console.error('Erro de cadastro (index.html):', e);
                
                // Verifica se é erro de rede/conexão
                if (e.name === 'TypeError' && e.message.includes('fetch')) {
                    Toast.error("Sem conexão com o servidor.");
                } else if (e.name === 'SyntaxError') {
                    Toast.error("Erro na resposta do servidor.");
                } else {
                    Toast.error("Ocorreu um erro inesperado.");
                }
            }
        }
        
        // 2. VERIFICAÇÃO DE SEGURANÇA (NOVO)
        // Se o usuário não tiver a flag 'verificado' ou ela for falsa/0
        function loginSuccess() {
            // 1. Esconde tela de login
            document.getElementById('authScreen').classList.add('hidden');
            
            // 2. VERIFICAÇÃO DE SEGURANÇA (NOVO)
            // Se o usuário não tiver a flag 'verificado' ou ela for falsa/0
            if (!USER.verificado || USER.verificado === 0 || USER.verificado === 'false') {
                // Mostra o Modal de Bloqueio
                document.getElementById('verifyModal').classList.remove('hidden');
                lucide.createIcons(); // Garante que os ícones do modal apareçam
                iniciarContagemReenvio(); // <--- ADICIONE ESTA LINHA
                return; // PARA AQUI. Não carrega o resto do site.
            }

            // 3. Se estiver verificado, segue o fluxo normal
            document.getElementById('verifyModal').classList.add('hidden'); // Garante que sumiu
            document.getElementById('appSidebar').classList.remove('hidden');
            document.getElementById('appSidebar').classList.add('flex');
            
            document.getElementById('userAvatarCircle').innerText = USER.name.charAt(0).toUpperCase();
            
            loadManagePersonas();
            
            // Atualiza os botões
            updateUserMenuCircle();
            updateAuthButton();
        }
        
        // Função para alternar visibilidade do menu circular
        function toggleUserMenuCircle() {
            const dropdown = document.getElementById('userMenuCircleDropdown');
            dropdown.classList.toggle('hidden');
            
            // Fechar ao clicar fora
            if (!dropdown.classList.contains('hidden')) {
                document.addEventListener('click', closeUserMenuCircleOnClickOutside);
            }
        }
        
        // Função para fechar o menu ao clicar fora
        function closeUserMenuCircleOnClickOutside(e) {
            const dropdown = document.getElementById('userMenuCircleDropdown');
            const btn = document.getElementById('avatarCircleBtn');
            if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
                dropdown.classList.add('hidden');
                document.removeEventListener('click', closeUserMenuCircleOnClickOutside);
            }
        }
        
        // Função para atualizar o menu circular com informações do usuário
        function updateUserMenuCircle() {
            const userInfoSection = document.getElementById('userInfoCircleSection');
            const userNameCircle = document.getElementById('userNameCircle');
            const userEmailCircle = document.getElementById('userEmailCircle');
            const userCreditsCircle = document.getElementById('userCreditsCircle');
            const userAvatarLarge = document.getElementById('userAvatarLarge');
            const userMenuCircleIcon = document.getElementById('userMenuCircleIcon');
            const userMenuCircleText = document.getElementById('userMenuCircleText');
            const userMenuCircleLogoutBtn = document.getElementById('userMenuCircleLogoutBtn');
            const userAvatarCircle = document.getElementById('userAvatarCircle');
            
            // Verifica se os elementos principais existem antes de manipulá-los
            if (!userAvatarCircle || !userMenuCircleIcon || !userMenuCircleText) {
                console.warn('Elementos do menu circular não encontrados');
                return;
            }
            
            if (!USER || !USER.email) {
                // Estado: Não logado
                if (userInfoSection) userInfoSection.classList.add('hidden');
                userAvatarCircle.textContent = 'U';
                userMenuCircleIcon.setAttribute('data-lucide', 'log-in');
                userMenuCircleText.textContent = 'Login';
                if (userMenuCircleLogoutBtn) userMenuCircleLogoutBtn.classList.remove('hover:bg-red-900/20', 'hover:text-red-400');
            } else {
                // Estado: Logado
                if (userInfoSection) userInfoSection.classList.remove('hidden');
                userAvatarCircle.textContent = USER.name.charAt(0).toUpperCase();
                if (userAvatarLarge) userAvatarLarge.textContent = USER.name.charAt(0).toUpperCase();
                if (userNameCircle) userNameCircle.textContent = USER.name || USER.email.split('@')[0];
                if (userEmailCircle) userEmailCircle.textContent = USER.email;
                if (userCreditsCircle) userCreditsCircle.textContent = USER.credits || 0;
                userMenuCircleIcon.setAttribute('data-lucide', 'log-out');
                userMenuCircleText.textContent = 'Sair';
                if (userMenuCircleLogoutBtn) userMenuCircleLogoutBtn.classList.add('hover:bg-red-900/20', 'hover:text-red-400');
            }
            // Recriar ícones Lucide
            lucide.createIcons();
        }
        
        // Função para alternar Login/Sair
        function handleLoginLogout() {
            if (!USER || !USER.email) {
                // Mostra tela de login
                document.getElementById('loginForm').classList.remove('hidden');
                document.getElementById('registerForm').classList.add('hidden');
                document.getElementById('authScreen').classList.remove('hidden');
            } else {
                // Faz logout
                logout();
            }
        }
        
        // Função para atualizar o estado do botão Login/Sair

        function logout() { localStorage.removeItem('ssw_user'); location.reload(); }

        function comprarCreditos() { window.open(`https://wa.me/5582991301991?text=Quero comprar créditos para ${USER.email}`, '_blank'); }

        // Função para controlar o botão de auth (cadastro/login vs settings)
        function handleAuthButton() {
            if (!USER || !USER.email) {
                // Mostra tela de cadastro/login
                showAuthScreen();
            } else {
                // Abrir menu de configurações do usuário
                showUserSettings();
            }
        }

        // Função para atualizar o estado do botão de auth
        function updateAuthButton() {
            const btn = document.getElementById('authButton');
            const icon = document.getElementById('authButtonIcon');
            const text = document.getElementById('authButtonText');
            
            // Verifica se os elementos existem antes de manipulá-los
            if (!btn || !icon || !text) {
                console.warn('Elementos do botão de auth não encontrados');
                return;
            }
            
            if (!USER || !USER.email) {
                // Estado: Não logado - mostrar cadastro/login
                icon.setAttribute('data-lucide', 'user-plus');
                text.textContent = 'Realizar Cadastro/Login';
                btn.classList.remove('hover:bg-orange-900/20', 'hover:text-orange-400');
                btn.classList.add('hover:bg-primary/20', 'hover:text-primary');
            } else {
                // Estado: Logado - mostrar engrenagem (settings)
                icon.setAttribute('data-lucide', 'settings');
                text.textContent = 'Configurações';
                btn.classList.remove('hover:bg-primary/20', 'hover:text-primary');
                btn.classList.add('hover:bg-orange-900/20', 'hover:text-orange-400');
            }
            // Recriar ícones Lucide
            lucide.createIcons();
        }

        // Função para mostrar configurações do usuário
        function showUserSettings() {
            // Criar menu de configurações flutuante
            const settingsMenu = document.createElement('div');
            settingsMenu.className = 'fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4';
            settingsMenu.innerHTML = `
                <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-md w-full">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-white">Configurações</h3>
                        <button onclick="this.closest('.fixed').remove()" class="text-slate-400 hover:text-white">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <div class="space-y-3">
                        <button onclick="logout(); this.closest('.fixed').remove();" class="w-full text-left px-4 py-3 text-slate-300 hover:bg-slate-800 rounded-lg transition-colors flex items-center gap-3">
                            <i data-lucide="log-out" class="w-4 h-4 text-red-400"></i>
                            <span>Sair do Sistema</span>
                        </button>
                        <button onclick="this.closest('.fixed').remove();" class="w-full text-left px-4 py-3 text-slate-300 hover:bg-slate-800 rounded-lg transition-colors flex items-center gap-3">
                            <i data-lucide="user" class="w-4 h-4 text-blue-400"></i>
                            <span>Meu Perfil</span>
                        </button>
                    </div>
                </div>
            `;
            document.body.appendChild(settingsMenu);
            // Recriar ícones Lucide
            lucide.createIcons();
        }

        async function confirmarCodigoAPI() {
            const codigoInput = document.getElementById('inputVerifyCode');
            const codigo = codigoInput.value.trim();
            const btn = event.target; // O botão clicado

            if (codigo.length < 4) return Toast.warning("Digite o código de 4 números.");
            
            // Verifica se USER existe e tem email
            if (!USER || !USER.email) {
                Toast.error("Usuário não encontrado. Faça login novamente.");
                logout();
                return;
            }

            // Efeito visual de carregando
            const textoOriginal = btn.innerHTML;
            btn.innerHTML = "Verificando...";
            btn.disabled = true;

            try {
                // Chama sua API no Replit
                const res = await fetch(`${API_URL}/api/verificar`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        email: USER.email, // Pega o email do usuário logado
                        codigo: codigo
                    })
                });

                const data = await res.json();

                if (res.ok) {
                    // SUCESSO!
                    Toast.success("Conta verificada com sucesso! Bem-vindo.");
                    
                    // Atualiza o usuário local para verificado
                    USER.verificado = true; 
                    localStorage.setItem('ssw_user', JSON.stringify(USER));
                    
                    // Recarrega a tela para liberar o acesso
                    loginSuccess(); 
                } else {
                    // ERRO (Código errado)
                    Toast.error(data.detail || "Código incorreto. Tente novamente.");
                    codigoInput.value = ""; // Limpa campo
                    codigoInput.focus();
                }

            } catch (e) {
                console.error(e);
                Toast.error("Erro de conexão com o servidor.");
            }

            // Restaura o botão
            btn.innerHTML = textoOriginal;
            btn.disabled = false;
        }

        async function loadManagePersonas() {
            const div = document.getElementById('managePersonasList');
            div.innerHTML = "<p class='text-slate-500 animate-pulse'>Sincronizando...</p>";
            
            // Verifica se USER está disponível
            if (!USER || !USER.id) {
                console.error('USER não disponível em loadManagePersonas');
                return;
            }
            
            try {
                const res = await fetch(`${API_URL}/api/personas?user_id=${String(USER.id)}`);
                const data = await res.json();
                
                const lista = data.custom_personas || [];
                
                if(lista.length === 0) div.innerHTML = "<div class='text-slate-500 col-span-3 text-center border border-dashed border-slate-700 p-8 rounded-xl'>Nenhum perfil criado.</div>";

                lista.forEach(p => {
                    div.innerHTML += `
                        <div class="glass-panel p-5 rounded-2xl border border-slate-800 relative group">
                            <div class="flex justify-between items-start mb-2">
                                <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-accent"><i data-lucide="user" class="w-4 h-4"></i></div>
                                <button onclick="deletePersona('${p.id}')" class="text-slate-600 hover:text-red-500 transition"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                            </div>
                            <h4 class="font-bold text-white">${p.name}</h4>
                            <p class="text-xs text-slate-400 mt-2 line-clamp-3">${p.description}</p>
                        </div>`;
                });
                lucide.createIcons();
            } catch(e) { console.error(e); }
        }

        async function createPersona() {
            const nome = document.getElementById('newPersonaName').value;
            const desc = document.getElementById('newPersonaDesc').value;
            if(!nome || !desc) return Toast.warning("Preencha todos os campos");
            
            const btn = event.target; btn.innerText = "..."; btn.disabled = true;
            try {
                await fetch(`${API_URL}/api/personas`, {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ user_id: String(USER.id), nome, descricao: desc })
                });

                document.getElementById('newPersonaName').value = "";
                document.getElementById('newPersonaDesc').value = "";
                await loadManagePersonas();
                if(document.getElementById('auditMode').value === 'manual') toggleManualSelect();
                Toast.success("Perfil salvo com sucesso!");
            } catch(e) { Toast.error("Erro ao criar perfil"); }
            btn.innerText = "SALVAR"; btn.disabled = false;
        }

        async function deletePersona(id) {
            if(!confirm("Remover perfil?")) return;

            await fetch(`${API_URL}/api/personas/${id}?user_id=${String(USER.id)}`, { method: 'DELETE' });

            loadManagePersonas();

            if(!document.getElementById('manualSelectArea').classList.contains('hidden')) toggleManualSelect();
        }



        // === 5. AUDIT LOGIC (CORE) ===



        // Função para criar estrutura HTML inicial dos resultados da auditoria
        function createAuditResultsStructure() {
            const resultsContainer = document.getElementById('auditResults');
            if (!resultsContainer) return;
            
            resultsContainer.innerHTML = `
                <!-- 1. Sumário Executivo -->
                <div class="glass-panel p-8 rounded-2xl border border-slate-700/50 mb-6">
                    <h3 class="text-primary font-bold uppercase text-lg mb-6 tracking-wider border-b border-slate-800 pb-4 flex items-center gap-3">
                        <i data-lucide="file-text" class="w-6 h-6"></i> 1. Sumário Executivo
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="text-center">
                            <div class="text-5xl font-black text-white mb-2" id="resScore">-</div>
                            <p class="text-sm text-slate-400">Score Geral</p>
                        </div>
                        <div class="text-center">
                            <div class="text-lg font-semibold text-cyber mb-2" id="resUrl">-</div>
                            <p class="text-sm text-slate-400">URL Analisada</p>
                        </div>
                        <div class="text-center">
                            <div class="flex justify-center gap-2 mb-2">
                                <img id="printMobile" class="w-16 h-16 rounded-lg border border-slate-700" alt="Mobile">
                                <img id="printDesktop" class="w-20 h-16 rounded-lg border border-slate-700" alt="Desktop">
                            </div>
                            <p class="text-sm text-slate-400">Capturas de Tela</p>
                        </div>
                    </div>
                    <div class="mt-6 p-4 bg-slate-900/30 rounded-xl border border-slate-800">
                        <p class="text-white leading-relaxed" id="resSummary">Carregando resumo...</p>
                    </div>
                </div>

                <!-- 2. Matriz de Vulnerabilidades -->
                <div class="glass-panel p-8 rounded-2xl border border-slate-700/50 mb-6">
                    <h3 class="text-orange-500 font-bold uppercase text-lg mb-6 tracking-wider border-b border-slate-800 pb-4 flex items-center gap-3">
                        <i data-lucide="shield-alert" class="w-6 h-6"></i> 2. Matriz de Vulnerabilidades
                    </h3>
                    <div class="space-y-3" id="vulnerabilitiesGrid">
                        <!-- Vulnerabilidades serão inseridas aqui -->
                    </div>
                </div>

                <!-- 3. Análise Comportamental -->
                <div class="glass-panel p-8 rounded-2xl border border-slate-700/50 mb-6">
                    <h3 class="text-emerald-500 font-bold uppercase text-lg mb-6 tracking-wider border-b border-slate-800 pb-4 flex items-center gap-3">
                        <i data-lucide="users" class="w-6 h-6"></i> 3. Análise Comportamental
                    </h3>
                    <div class="space-y-4" id="personasGrid">
                        <!-- Personas serão inseridas aqui -->
                    </div>
