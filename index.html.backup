    <script src="https://cdn.tailwindcss.com"></script>



    <script>



        tailwind.config = {



            darkMode: 'class',



            theme: {



                extend: {



                    colors: {



                        slate: { 950: '#0a0a0f', 900: '#1a1a2e', 800: '#2d2d44', 700: '#404055' },



                        primary: { DEFAULT: '#4A90E2', hover: '#357ABD', glow: 'rgba(74, 144, 226, 0.5)' }, 



                        accent: { DEFAULT: '#C0C0C0', hover: '#A8A8A8' }, 



                        cyber: { DEFAULT: '#6B7280', hover: '#4B5563' } 



                    },



                    fontFamily: { sans: ['Inter', 'sans-serif'] },



                    animation: {



                        'blob': 'blob 10s infinite',



                        'fade-in-up': 'fadeInUp 0.6s ease-out forwards',



                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',



                        'glow': 'glow 2s ease-out infinite',



                        'float': 'float 2s ease-out infinite',



                        'pulse-cyber': 'pulse-cyber 2s ease-out infinite',



                    },



                    keyframes: {



                        blob: {



                            '0%': { transform: 'translate(0px, 0px) scale(1)' },



                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },



                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },



                            '100%': { transform: 'translate(0px, 0px) scale(1)' },



                        },



                        fadeInUp: {



                            '0%': { opacity: '0', transform: 'translateY(20px)' },



                            '100%': { opacity: '1', transform: 'translateY(0)' },



                        },



                    }



                }



            }



        }



    </script>



    



