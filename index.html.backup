        // --- FUNÇÃO DE COMPRA SEGURA (ENVIA APENAS O ID) ---
        async function comprarPlano(pacoteId) {
            if(!USER || !USER.email) {
                showAuthScreen(); 
                return;
            }

            const btn = event.target;
            const textoOriginal = btn.innerHTML;
            
            // Feedback visual
            btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Processando...';
            btn.disabled = true;
            if(typeof lucide !== 'undefined') lucide.createIcons();
            
            try {
                const res = await fetch(`${API_URL}/api/pagamento/checkout`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        user_id: String(USER.id),
                        email: USER.email,
                        pacote_id: pacoteId // ENVIA SÓ O ID DO PACOTE
                    })
                });

                const data = await res.json();

                if (data.checkout_url) {
                    // Redireciona para o Mercado Pago
                    window.location.href = data.checkout_url;
                } else {
                    Toast.error(data.detail || "Erro ao criar pagamento.");
                    btn.innerHTML = textoOriginal;
                    btn.disabled = false;
                }
            } catch(e) {
                console.error(e);
                Toast.error("Erro de conexão.");
                btn.innerHTML = textoOriginal;
                btn.disabled = false;
            }
        }

</script>

