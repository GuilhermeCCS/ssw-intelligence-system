    <style>



        /* =========================================



           1. FUNDAMENTOS & BACKGROUND



           ========================================= */



        body { 



            font-family: 'Inter', sans-serif; 



            background-color: #020817; 



            color: #e2e8f0; 



            overflow-x: hidden;



        }







        /* Holofote de Luz no Topo */



        body::before {



            content: '';



            position: fixed;



            top: -20%;



            left: 20%;



            width: 60%;



            height: 60%;



            background: radial-gradient(circle, rgba(74, 144, 226, 0.07) 0%, transparent 70%);



            z-index: -1;



            pointer-events: none;



        }







        /* =========================================



           2. ESTILOS VISUAIS (GLASS & UI)



           ========================================= */



        .glass-panel { 



            background: rgba(26, 26, 46, 0.75); 



            backdrop-filter: blur(20px); 



            -webkit-backdrop-filter: blur(20px); 



            border: 1px solid rgba(192, 192, 192, 0.08); 



            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .glass-panel:hover {
            border-color: rgba(192, 192, 192, 0.15);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
        }







        /* Inputs Profissionais */



        .input-pro {
            background: rgba(26, 26, 46, 0.8);
            border: 1px solid #404055;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .input-pro:focus {
            border-color: #4A90E2;
            box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);
            outline: none;
            background: rgba(26, 26, 46, 0.95);
        }







        /* Botão Primário com Brilho */



        .btn-primary {
            background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(74, 144, 226, 0.4);
            filter: brightness(1.1);
        }







        /* Cards Interativos */



        .hover-card {
            transition: transform 0.2s, border-color 0.2s;
        }

        .hover-card:hover {
            transform: translateY(-4px);
            border-color: rgba(74, 144, 226, 0.3);
        }







        /* Scrollbar Fina */



        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #4A90E2;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #4A90E2;
        }

        /* =========================================
           2B. ESTILOS DO RELATÓRIO CORPORATIVO
           ========================================= */

        .report-container {
            background: white;
            color: #333;
            padding: 40px;
            max-width: 900px;
            margin: 0 auto;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            line-height: 1.6;
        }

        .report-page {
            background: white;
            padding: 40px;
            margin-bottom: 30px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            page-break-after: always;
        }

        .report-page:last-child {
            page-break-after: avoid;
            margin-bottom: 0;
        }

        .report-section {
            margin: 25px 0;
            padding: 15px 20px;
            border-left: 4px solid #0066cc;
            background: #f9fafb;
            border-radius: 4px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 13px;
        }

        .report-table th {
            background: #f5f5f5;
            color: #333;
            font-weight: 600;
            padding: 12px;
            text-align: left;
            border: 1px solid #ddd;
        }

        .report-table td {
            padding: 12px;
            border: 1px solid #ddd;
            color: #333;
        }

        .report-table tr:nth-child(even) {
            background: #fafafa;
        }

        /* Classe para esconder durante impressão */
        .no-print {
            display: block !important;
        }







        /* =========================================



           3. MODO IMPRESSÃO (PDF LIMPO)



           ========================================= */



        @media print {

            @page {
                margin: 0;
                size: A4;
                orphans: 3;
                widows: 3;
            }

            /* Configuração base para impressão */
            * {
                print-color-adjust: exact !important;
                -webkit-print-color-adjust: exact !important;
            }

            html, body {
                width: 100% !important;
                height: auto !important;
                background: white !important;
                color: black !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: visible !important;
                box-sizing: border-box !important;
            }

            /* Esconde navegação, sidebars e elementos de UI */
            aside, nav, header, footer, #appSidebar, #sidebarOverlay, 
            #authScreen, #chatModal, #verifyModal, .no-print, button, input,
            .sticky, .fixed {
                display: none !important;
            }

            /* Esconde todas as views EXCETO conteúdo do relatório */
            #view-personas, #view-ranking, #view-precos, 
            #view-about, #view-tutorial, #view-terms,
            #emptyStateCards, #auditLoading, #compareArea,
            #manualSelectArea, .hero-section-premium,
            .stats-container-premium, #mainFooter {
                display: none !important;
            }

            main {
                display: flex !important;
                width: 100% !important;
                height: auto !important;
                flex-direction: column !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: visible !important;
            }

            #mainContent {
                display: flex !important;
                width: 100% !important;
                height: auto !important;
                flex-direction: column !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                overflow: visible !important;
            }

            #mainContentWrapper {
                display: flex !important;
                width: 100% !important;
                height: auto !important;
                flex-direction: column !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                overflow: visible !important;
            }

            #view-home {
                display: block !important;
                width: 100% !important;
                height: auto !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                overflow: visible !important;
            }

            /* Mostra apenas o auditResults */
            #auditResults {
                display: block !important;
                visibility: visible !important;
                background: white !important;
                color: black !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: auto !important;
                position: static !important;
                overflow: visible !important;
            }

            /* Recursivamente mostra conteúdo do relatório */
            #auditResults * {
                display: block !important;
                visibility: visible !important;
                background: white !important;
                color: black !important;
                overflow: visible !important;
                height: auto !important;
            }

            .report-container {
                display: block !important;
                visibility: visible !important;
                background: white !important;
                color: black !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: visible !important;
                height: auto !important;
            }

            .report-container * {
                display: block !important;
                visibility: visible !important;
                overflow: visible !important;
                height: auto !important;
            }

            .report-page {
                display: block !important;
                visibility: visible !important;
                page-break-after: always !important;
                break-after: page !important;
                background: white !important;
                color: black !important;
                margin: 0 !important;
                padding: 40px 50px !important;
                width: 100% !important;
                box-sizing: border-box !important;
                height: auto !important;
                overflow: visible !important;
            }

            .report-page * {
                display: block !important;
                visibility: visible !important;
                color: black !important;
                overflow: visible !important;
                height: auto !important;
            }

            /* Estilos de Tabelas para o Relatório */
            .report-table {
                width: 100% !important;
                border-collapse: collapse !important;
                margin: 20px 0 !important;
                page-break-inside: avoid !important;
            }

            .report-table thead {
                display: table-header-group !important;
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
            }

            .report-table tbody {
                display: table-row-group !important;
            }

            .report-table tr {
                page-break-inside: avoid !important;
                display: table-row !important;
            }

            .report-table th,
            .report-table td {
                border: 1px solid #ccc !important;
                padding: 10px !important;
                color: black !important;
                display: table-cell !important;
            }

            .report-table th {
                background: #f5f5f5 !important;
                font-weight: bold !important;
            }

            .report-section {
                page-break-inside: avoid !important;
                margin: 20px 0 !important;
                padding: 15px 20px !important;
                border-left: 4px solid #333 !important;
                background: #f9fafb !important;
            }

            .report-gap-grid {
                display: block !important;
                page-break-inside: avoid !important;
                margin: 20px 0 !important;
            }

            .report-gap-column {
                display: block !important;
                page-break-inside: avoid !important;
                margin: 15px 0 !important;
                padding: 15px !important;
                background: white !important;
                border: 1px solid #ddd !important;
            }

            .report-checklist {
                display: block !important;
                margin: 0 !important;
                padding-left: 20px !important;
                list-style: decimal !important;
            }

            .report-checklist li {
                display: list-item !important;
                margin: 12px 0 !important;
                font-size: 13px !important;
                line-height: 1.6 !important;
                padding: 8px !important;
                background: #fafafa !important;
                page-break-inside: avoid !important;
            }

            /* Garante que listas ul/ol apareçam completamente */
            ul, ol {
                page-break-inside: avoid !important;
                display: block !important;
            }

            li {
                display: list-item !important;
                page-break-inside: avoid !important;
            }

            /* Garante que parágrafos e headings não sejam cortados */
            h1, h2, h3, h4, h5, h6, p, div {
                orphans: 3 !important;
                widows: 3 !important;
            }

            /* Esconde elementos de UI e navegação */
            .sticky, .fixed, button, input, select, textarea {
                display: none !important;
            }

        }



        



        /* Animações Profissionais */



        .fade-in {



            animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;



        }



        



        .slide-up {



            animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;



        }



        



        .scale-in {



            animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;



        }



        



        @keyframes fadeIn {



            from { opacity: 0; transform: translateY(10px); }



            to { opacity: 1; transform: translateY(0); }



        }



        



        @keyframes slideUp {



            from { opacity: 0; transform: translateY(20px); }



            to { opacity: 1; transform: translateY(0); }



        }



        



        @keyframes scaleIn {



            from { opacity: 0; transform: scale(0.95); }



            to { opacity: 1; transform: scale(1); }



        }



        



        /* Hover Effects Avançados */



        .card-hover {



            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);



            position: relative;



        }



        



        .card-hover::before {



            content: '';



            position: absolute;



            inset: 0;



            background: linear-gradient(135deg, transparent, rgba(16, 185, 129, 0.1));



            opacity: 0;



            transition: opacity 0.3s;



            border-radius: inherit;



        }



        



        .card-hover:hover::before {



            opacity: 1;



        }



        



        .card-hover:hover {



            transform: translateY(-8px) scale(1.02);



            box-shadow: 0 20px 40px rgba(16, 185, 129, 0.15);



            border-color: rgba(16, 185, 129, 0.3);



        }



        



        /* Botões com Efeito de Brilho */



        .btn-glow {



            position: relative;



            overflow: hidden;



            transition: all 0.3s;



        }



        



        .btn-glow::after {



            content: '';



            position: absolute;



            top: 50%;



            left: 50%;



            width: 0;



            height: 0;



            border-radius: 50%;



            background: rgba(255, 255, 255, 0.3);



            transform: translate(-50%, -50%);



            transition: width 0.6s, height 0.6s;



        }



        



        .btn-glow:hover::after {
            overflow: hidden; 
            opacity: 0; 
            transform: translateX(-100%);
        }



    </style>



    <style>

        /* CSS para posicionamento do footer durante auditoria */

        .audit-footer-position {

            position: relative !important;

            width: 100% !important;

            margin: 3rem 0 0 0 !important;

            padding: 1rem 1.5rem !important;

            border-top: 1px solid #334155 !important;

            background: #0f172a !important;

            z-index: 1 !important;

            clear: both !important;

            box-sizing: border-box !important;

            left: 0 !important;

            right: 0 !important;

        }

        

        /* Garante que o container do footer ocupe toda largura */

        #auditResults .audit-footer-position {

            margin-left: 0 !important;

            margin-right: 0 !important;

            padding-left: 0 !important;

            padding-right: 0 !important;

        }

        

        /* Garante que o body permita scroll */

        body {

            min-height: 100vh;

        }

        

        /* Remove overflow hidden do body durante auditoria */

        body.audit-active {
            overflow: auto !important;
            height: auto !important;
        }

        /* Ajusta main durante auditoria */
        body.audit-active main {
            padding-bottom: 0 !important;
        }

        /* Rolagem horizontal para planos em telas pequenas */
        @media (max-width: 767px) {
            #view-precos .grid {
