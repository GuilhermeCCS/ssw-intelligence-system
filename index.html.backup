    <body class="min-h-screen flex flex-col selection:bg-primary selection:text-white">

    <!-- Ambient Glow Background Effects -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>

    <!-- Toast Notification Container -->
    <div id="toastContainer"></div>

    <script>
        // Toast Notification System - Substitui window.alert()
        const Toast = {
            show(message, type = 'info', duration = 4000) {
                const container = document.getElementById('toastContainer');
                const icons = { success: 'check-circle', error: 'x-circle', warning: 'alert-triangle', info: 'info' };
                const colors = { success: '#10B981', error: '#EF4444', warning: '#F59E0B', info: '#3B82F6' };
                
                const toast = document.createElement('div');
                toast.className = `toast toast-${type}`;
                toast.innerHTML = `
                    <i data-lucide="${icons[type]}" style="width:20px;height:20px;color:${colors[type]};flex-shrink:0;"></i>
                    <div style="flex:1;"><p style="margin:0;font-size:14px;font-weight:500;color:white;">${message}</p></div>
                    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;padding:4px;">
                        <i data-lucide="x" style="width:16px;height:16px;"></i>
                    </button>
                `;
                
                container.appendChild(toast);
                if (typeof lucide !== 'undefined') lucide.createIcons();
                
                setTimeout(() => {
                    toast.classList.add('hiding');
                    setTimeout(() => toast.remove(), 300);
                }, duration);
            }
        };
        Toast.success = (m, d) => Toast.show(m, 'success', d);
        Toast.error = (m, d) => Toast.show(m, 'error', d);
        Toast.warning = (m, d) => Toast.show(m, 'warning', d);
        Toast.info = (m, d) => Toast.show(m, 'info', d);
    </script>

    <script>

        const API_URL = "https://82e29984-9ee4-4727-929e-57421b477e7a-00-2bi525obh81pp.worf.replit.dev";


        // Função para mostrar tela de autenticação

        function showAuthScreen() {

            document.getElementById('loginForm').classList.remove('hidden');

            document.getElementById('registerForm').classList.add('hidden');

            document.getElementById('authScreen').classList.remove('hidden');

            document.getElementById('mainContent').style.opacity = '0.3';

            document.getElementById('appSidebar').style.opacity = '0.3';

        }



        // Função para esconder tela de autenticação

        function hideAuthScreen() {

            document.getElementById('authScreen').classList.add('hidden');

            document.getElementById('mainContent').style.opacity = '1';

            document.getElementById('appSidebar').style.opacity = '1';

        }



        // Verificar se clique foi em botão que não é do footer

        function handleButtonClick(event) {

            const button = event.target.closest('button');

            const link = event.target.closest('a');

            const element = button || link;
            
            if (!element) return;
            
            // Verificar se está no footer

            const footer = document.getElementById('mainFooter');

            const isInFooter = footer && footer.contains(element);
            
            // Se não estiver no footer e não estiver autenticado, mostrar tela de login
            if (!isInFooter && !USER) {

                event.preventDefault();

                event.stopPropagation();

                showAuthScreen();

            }
        }

        // Função para limitar seleção de personas a no máximo 3

        function limitPersonaSelection(checkbox) {

            const checkedBoxes = document.querySelectorAll('.persona-checkbox:checked');

            

            if (checkedBoxes.length > 3) {

                checkbox.checked = false;

                Toast.warning('Você pode selecionar no máximo 3 personas.');

            }

        }



        



        // --- PERSONAS DO SISTEMA ---



        const SYSTEM_PERSONAS = [



            { name: "O Comprador Impulsivo", desc: "Decide em segundos. Não lê descrições longas. Kryptonita: Formulários longos, botão de comprar escondido, falta de checkout rápido." },

            { name: "O Investigador Analítico", desc: "Lê tabela nutricional, política de troca e FAQ antes de comprar. Kryptonita: Falta de informações técnicas, fotos de baixa qualidade." },

            { name: "O Desconfiado", desc: "Tem medo de clonarem o cartão. Procura cadeado SSL, CNPJ no rodapé e selos de segurança. Kryptonita: Design amador, erros de português." },

            { name: "O Caçador de Promoções", desc: "Só converte se sentir que está levando vantagem. Kryptonita: Frete abusivo, dificuldade de encontrar ofertas ou aplicar cupom." },

            { name: "O Idoso Analógico", desc: "Digita com um dedo, dificuldade de visão e medo de errar a senha. Kryptonita: Fontes minúsculas, baixo contraste, menus complexos." },

            { name: "O Gen Z Apressado", desc: "Navega exclusivamente pelo celular. Acostumado com ritmo do TikTok. Kryptonita: Blocos de texto gigantes, carregamento lento." },

            { name: "O Millennial Exigente", desc: "Valoriza estética (UI) e responsabilidade social da empresa. Kryptonita: Sites feios, layout poluído, sem seção 'Sobre Nós'." },

            { name: "O Estrangeiro/Imigrante", desc: "Não domina a língua nativa do site perfeitamente. Kryptonita: Falta de ícones universais, gírias locais excessivas." },

            { name: "O Daltônico / Baixa Visão", desc: "Depende de alto contraste para diferenciar elementos. Kryptonita: Avisos de erro baseados apenas em cor, contraste ruim." },

            { name: "O Motoramente Limitado", desc: "Usa tecla TAB para navegar ou tem tremores nas mãos. Kryptonita: Elementos clicáveis muito pequenos e colados." },

            { name: "O Neurodivergente (TDAH/Autismo)", desc: "Facilmente sobrecarregado por estímulos visuais e sonoros. Kryptonita: Vídeos com autoplay, pop-ups pulando na tela." },

            { name: "O Viajante 3G", desc: "Está no ônibus ou metrô, com sinal oscilando. Kryptonita: Imagens de 5MB, site em branco até carregar tudo." },

            { name: "O Multitarefas", desc: "Tem 40 abas abertas no navegador ao mesmo tempo. Kryptonita: Title Tag sem nome da empresa, falta de favicon claro." },

            { name: "O Trabalhador Disfarçado", desc: "Navegando escondido no trabalho. Precisa de discrição. Kryptonita: Áudio/vídeo começando sozinho, cores gritantes." },

            { name: "O Leitor Dinâmico (Skimmer)", desc: "Não lê, escaneia a página em formato de 'F'. Kryptonita: Falta de intertítulos, textos sem formatação, falta de listas." },

            { name: "O C-Level Executivo", desc: "Tempo é dinheiro. Quer saber ROI e a solução imediata. Kryptonita: Promessas vagas, dificuldade de achar página de Preços." },

            { name: "O Tech Snob (Desenvolvedor/Especialista)", desc: "Abre 'Inspecionar Elemento' para julgar como o site foi feito. Kryptonita: Tecnologias obsoletas, erros no console." },

            { name: "O Analista de Compras/RH", desc: "Precisa de PDFs, documentos, garantias e contato direto. Kryptonita: Esconder botão 'Fale com Vendas', falta de contato corporativo." },

            { name: "O Cliente Recorrente", desc: "Quer pular introdução e ir direto para login ou produto. Kryptonita: Ocultar botão Login, obrigar tutoriais sempre." },

            { name: "O Espião (O Concorrente)", desc: "Não vai comprar, quer ver como cliente faz as coisas. Sistema analisa proteção de dados e vulnerabilidade." }

        ];



    </script>







