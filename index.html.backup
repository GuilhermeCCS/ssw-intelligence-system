                <!-- Compare Area -->
                <div id="compareArea" class="hidden glass-panel p-6 rounded-2xl border border-slate-800/50">
                    <div class="flex items-center gap-2 mb-4 text-accent">
                        <i data-lucide="git-compare" class="w-5 h-5"></i>
                        <span class="text-sm font-bold uppercase tracking-wider">Modo Comparativo</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="relative">
                            <label class="absolute -top-2.5 left-4 bg-slate-900 px-2 text-[10px] font-bold text-slate-400 uppercase">Site A</label>
                            <input type="text" id="compareUrlA" placeholder="https://site-a.com" class="input-pro w-full rounded-xl p-4 text-white">
                        </div>
                        <div class="relative">
                            <label class="absolute -top-2.5 left-4 bg-slate-900 px-2 text-[10px] font-bold text-slate-400 uppercase">Site B</label>
                            <input type="text" id="compareUrlB" placeholder="https://site-b.com" class="input-pro w-full rounded-xl p-4 text-white">
                        </div>
                    </div>
                    <button onclick="runCompare()" class="btn-primary w-full text-white font-bold py-4 rounded-xl">
                        <i data-lucide="git-compare" class="w-4 h-4 inline mr-2"></i> Comparar Sites
                    </button>
                </div>

                <!-- Empty State Cards - Quick Actions -->
